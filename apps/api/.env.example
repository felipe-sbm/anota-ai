# Configurações necessárias para executar a API.

# Modelo local de transcrição.
WHISPER_MODEL_SIZE=base

# Configurações do GitHub.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/api/auth/github/callback
GITHUB_SCOPE=repo,user

# JWT
JWT_SECRET=change-me
JWT_ALG=HS256
JWT_EXPIRE_SECONDS=28800

# API da Groq. Crie a chave em https://console.groq.com/keys.
# Para usar a Groq, preencha a chave e mantenha a sumarização habilitada.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
LLM_SUMMARIZATION_ENABLED=true

# CORS.
CORS_ALLOW_ORIGINS=*

# URL do frontend.
UI_BASE_URL=http://localhost:3000
