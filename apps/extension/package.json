{
  "name": "anota-ai-extension",
  "displayName": "Anota Aí Extension",
  "version": "0.0.19",
  "description": "Anota Ai it's a web extension to provide texts and tasks about sprints.",
  "author": "Felipe SBM <felipe.sbm@otsuki.dev>",
  "scripts": {
    "dev": "npm run tailwind:build && plasmo dev",
    "build": "npm run tailwind:build && plasmo build",
    "tailwind:build": "tailwindcss -i ./styles/tailwind.css -o ./styles/tailwind.generated.css --minify",
    "package": "npm run tailwind:build && plasmo package",
    "prepare": "husky"
  },
  "dependencies": {
    "lucide-react": "^0.407.0",
    "plasmo": "^0.90.5",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-select": "^5.10.2",
    "sass": "^1.101.0"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.1.1",
    "@tailwindcss/cli": "^4.3.3",
    "@types/chrome": "0.0.258",
    "@types/node": "20.11.5",
    "@types/react": "18.2.48",
    "@types/react-dom": "18.2.18",
    "husky": "^9.1.7",
    "prettier": "3.2.4",
    "tailwindcss": "^4.3.3",
    "typescript": "5.3.3"
  },
  "manifest": {
    "host_permissions": [
      "https://*/*"
    ],
    "permissions": [
      "microphone",
      "storage",
      "tabs"
    ]
  }
}
